# EOL boundary lock for shannon-prime-lattice (kills CRLF churn permanently).
# Text files are stored as LF in the repo and checked out as LF.
* text=auto eol=lf

# Windows scripts keep CRLF on checkout
*.ps1 text eol=crlf

# Shell scripts are always LF
*.sh text eol=lf

# Binaries: never normalize
*.png binary
*.pdf binary