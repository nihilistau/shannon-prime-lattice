{
    "folders": [
        {
            "name": "lattice (umbrella + papers + roadmap)",
            "path": "."
        },
        {
            "name": "system (math core)",
            "path": "../shannon-prime-system"
        },
        {
            "name": "system-engine (inference engine + backends)",
            "path": "../shannon-prime-system-engine"
        }
    ],
    "settings": {
        "files.exclude": {
            "**/.git": true,
            "**/build": true,
            "**/build-*": true,
            "**/.cache": true,
            "**/_deps": true
        },
        "search.exclude": {
            "**/build*/**": true,
            "**/_deps/**": true,
            "**/*.pdf": true
        },
        "C_Cpp.default.cStandard": "c11",
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.intelliSenseMode": "windows-msvc-x64",
        "C_Cpp.default.compileCommands": "${workspaceFolder:system-engine (inference engine + backends)}/build-cpu/compile_commands.json",
        "cmake.configureOnOpen": false,
        "cmake.useCMakePresets": "never",
        "files.associations": {
            "*.cmake": "cmake",
            "*.h": "c",
            "*.hpp": "cpp",
            "*.cu": "cpp",
            "*.cuh": "cpp",
            "*.comp": "glsl",
            "*.vert": "glsl",
            "*.frag": "glsl"
        },
        "editor.rulers": [80, 100],
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "[c]": {
            "editor.tabSize": 4
        },
        "[cpp]": {
            "editor.tabSize": 4
        },
        "[cmake]": {
            "editor.tabSize": 4
        },
        "[markdown]": {
            "editor.wordWrap": "on",
            "editor.rulers": []
        },
        "terminal.integrated.defaultProfile.windows": "Command Prompt"
    },
    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "twxs.cmake",
            "nvidia.nsight-vscode-edition",
            "slevesque.shader",
            "ms-vscode.hexeditor",
            "github.copilot",
            "ms-python.python",
            "yzhang.markdown-all-in-one",
            "asciidoctor.asciidoctor-vscode"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "build: CPU",
                "type": "shell",
                "command": "${workspaceFolder:system-engine (inference engine + backends)}\\scripts\\build\\build-cpu.bat",
                "group": "build",
                "presentation": { "panel": "dedicated", "clear": true }
            },
            {
                "label": "build: CUDA",
                "type": "shell",
                "command": "${workspaceFolder:system-engine (inference engine + backends)}\\scripts\\build\\build-cuda.bat",
                "group": "build",
                "presentation": { "panel": "dedicated", "clear": true }
            },
            {
                "label": "build: Vulkan",
                "type": "shell",
                "command": "${workspaceFolder:system-engine (inference engine + backends)}\\scripts\\build\\build-vulkan.bat",
                "group": "build",
                "presentation": { "panel": "dedicated", "clear": true }
            },
            {
                "label": "build: Hexagon",
                "type": "shell",
                "command": "${workspaceFolder:system-engine (inference engine + backends)}\\scripts\\build\\build-hexagon.bat",
                "group": "build",
                "presentation": { "panel": "dedicated", "clear": true }
            },
            {
                "label": "test: CPU smoke",
                "type": "shell",
                "command": "${workspaceFolder:system-engine (inference engine + backends)}\\scripts\\smoke\\smoke-cpu.bat",
                "group": "test",
                "presentation": { "panel": "dedicated", "clear": true }
            },
            {
                "label": "papers: regenerate PDFs",
                "type": "shell",
                "command": "${workspaceFolder:lattice (umbrella + papers + roadmap)}\\scripts\\render-papers.bat",
                "presentation": { "panel": "dedicated", "clear": true }
            }
        ]
    }
}
